PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/astrology

# Auth
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_SECRET=change-me

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email (local: Gmail app password | production Render: use Brevo/SendGrid SMTP)
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="DS Astrology" <no-reply@example.com>
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false

# Supabase (image/video uploads)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=course-images

# Bunny.net Stream (course videos)
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_TOKEN_KEY=

# ─── Free Consultation AI (Gemini) ───────────────────────────────────────────
# Key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Working model in this project: gemini-2.0-flash (or gemini-1.5-flash on free tier)
GEMINI_MODEL=gemini-2.0-flash
FREE_CONSULTATION_LLM_TIMEOUT_MS=10000
GEMINI_MAX_RETRIES=3

# ─── Free Consultation Facts — Brain 1 (astrologyapi.com) ────────────────────
# Dashboard/token: https://astrologyapi.com
ASTROLOGYAPI_KEY=
ASTROLOGYAPI_TIMEOUT_MS=6000

# First counsellor account (auto-created on first login if none exist)
COUNSELLOR_BOOTSTRAP_EMAIL=counsellor@yourdomain.com
COUNSELLOR_BOOTSTRAP_PASSWORD=change-me-strong-password
COUNSELLOR_BOOTSTRAP_NAME=Counsellor Name

# CORS — comma-separated extra frontend URLs (optional; defaults include localhost + dsastrology.com)
# ALLOWED_ORIGINS=https://www.dsastrology.com,https://dsastrology.com
# Or set a single canonical site:
# FRONTEND_URL=https://www.dsastrology.com
